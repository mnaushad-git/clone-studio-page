# Start-Stack.ps1 copies this to deploy/local/.env.local (git-ignored) on first run and
# fills every blank value with its own random secret.
POSTGRES_ADMIN_PASSWORD=
APP_DB_PASSWORD=
ODOO_DB_PASSWORD=
ODOO_ADMIN_PASSWD=
ODOO_ORDER_SYNC_PASSWORD=
ODOO_CATALOGUE_IMPORT_PASSWORD=
REDIS_PASSWORD=
ADMIN_JWT_SECRET=

# Loopback ports. None of these clash with myMakan (8000, 8080-8083), Maskan (8010), the
# native PostgreSQL (5432), Memurai (6379) or the native Odoo (8069).
TB_HTTP_PORT=18080
TB_ODOO_PORT=18069
ODOO_ORDER_SYNC_LOGIN=terrific-order-sync
ODOO_CATALOGUE_IMPORT_LOGIN=terrific-catalogue-import
