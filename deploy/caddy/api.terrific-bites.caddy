# STAGING API site for the host Caddy on the dedicated VPS (2.25.11.35). Copied to
# /etc/caddy/sites/ and imported by /etc/caddy/Caddyfile; see "Install Caddy" in
# docs/deployment/hostinger-deployment-package.md. Caddy issues the certificate itself once
# the api.terrific-bites A record resolves to the VPS. Validate before every reload.
api.terrific-bites.trunexus.ai {
	encode gzip

	header {
		# Matches the app's own expectation that it is only served over HTTPS.
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		# Staging: keep it out of search results.
		X-Robots-Tag "noindex, nofollow"
		-Server
	}

	reverse_proxy 127.0.0.1:18010 {
		health_uri /api/v1/health
		health_headers {
			Host api.terrific-bites.trunexus.ai
		}
		health_interval 30s
	}

	log {
		output file /var/log/caddy/api.terrific-bites.log {
			roll_size 10mb
			roll_keep 5
		}
	}
}
