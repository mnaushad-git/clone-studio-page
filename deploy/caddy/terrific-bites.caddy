# STAGING storefront and Admin Portal site for the host Caddy on the dedicated VPS
# (2.25.11.35), next to api.terrific-bites.caddy. The certificate is only issued once the
# terrific-bites record points at the VPS, and that DNS change is what moves staging off
# Lovable: it needs explicit approval. Before then, validate through preview.terrific-bites
# (see "Pre-cutover validation" in docs/deployment/hostinger-deployment-package.md).
terrific-bites.trunexus.ai {
	encode gzip

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "SAMEORIGIN"
		Referrer-Policy "strict-origin-when-cross-origin"
		# Staging: keep it out of search results.
		X-Robots-Tag "noindex, nofollow"
		-Server
	}

	reverse_proxy 127.0.0.1:18011 {
		health_uri /
		health_interval 30s
	}

	log {
		output file /var/log/caddy/terrific-bites.log {
			roll_size 10mb
			roll_keep 5
		}
	}
}
