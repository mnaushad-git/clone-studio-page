# Copy to deploy/.env.prod on the server, then: chmod 600 .env.prod
# The real file is git-ignored and must never be committed or copied off the server.
# Generate each secret separately with: openssl rand -hex 32
# Use hex values: these are placed inside connection URLs unescaped.

# --- Compose substitution --------------------------------------------------------------
# Git SHA of the image to run. Changing this and re-running `up -d` is also the rollback.
TB_IMAGE_TAG=
# Free loopback port for the reverse proxy. Confirm with vps-discovery.sh before choosing.
API_HOST_PORT=18010
FRONTEND_HOST_PORT=18011
# Loopback only, for an SSH tunnel to the Odoo web client.
ODOO_HOST_PORT=18069
POSTGRES_ADMIN_PASSWORD=
# The application's own database role.
POSTGRES_PASSWORD=
ODOO_DB_PASSWORD=
ODOO_ADMIN_PASSWD=
# Least-privilege Odoo users created by deploy/odoo/bootstrap.py. Compose passes the order
# sync login to the worker only and the import login to the one-shot import only.
ODOO_ORDER_SYNC_LOGIN=terrific-order-sync
ODOO_ORDER_SYNC_PASSWORD=
ODOO_CATALOGUE_IMPORT_LOGIN=terrific-catalogue-import
ODOO_CATALOGUE_IMPORT_PASSWORD=
REDIS_PASSWORD=

# --- Application secrets ----------------------------------------------------------------
ADMIN_JWT_SECRET=

# Where monitor.sh sends alerts. Configure either or both, then check with
# scripts/monitor.sh --test-alert and confirm the message actually arrives.
# A Slack or Discord incoming webhook, or any endpoint accepting a JSON POST. Treat as a secret.
ALERT_WEBHOOK_URL=
# Email. Hostinger's values are shown; the user is the mailbox's full address.
ALERT_EMAIL_TO=
ALERT_EMAIL_FROM=
ALERT_SMTP_URL=smtps://smtp.hostinger.com:465
ALERT_SMTP_USER=
ALERT_SMTP_PASSWORD=

# --- Public addressing ------------------------------------------------------------------
API_PUBLIC_HOST=api.terrific-bites.trunexus.ai
# "api" is the private hostname the frontend's server-side rendering uses.
TRUSTED_HOSTS=api.terrific-bites.trunexus.ai,api
CORS_ALLOWED_ORIGINS=https://terrific-bites.trunexus.ai
ADMIN_COOKIE_DOMAIN=terrific-bites.trunexus.ai
MEDIA_BASE_URL=https://api.terrific-bites.trunexus.ai/media

LOG_LEVEL=INFO

# --- Odoo (the self-hosted container in this stack) ---------------------------------------
# Container-network address, so no TLS is involved. Order push stays on the stub regardless;
# it is fixed in docker-compose.prod.yml.
ODOO_BASE_URL=http://odoo:8069
ODOO_DATABASE=terrific_odoo
# Must stay blank unless production catalogue writes have separate written authorization.
# Blank refuses every Odoo write. The only accepted value is <ODOO_BASE_URL>#<ODOO_DATABASE>.
ODOO_WRITE_APPROVED_TARGET=
