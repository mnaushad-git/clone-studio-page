# Copy to deploy/.env.prod on the server, then: chmod 600 .env.prod
# The real file is git-ignored and must never be committed or copied off the server.
# Generate each secret separately with: openssl rand -hex 32
# Use hex values: these are placed inside connection URLs unescaped.

# --- Compose substitution --------------------------------------------------------------
# Git SHA of the image to run. Changing this and re-running `up -d` is also the rollback.
TB_IMAGE_TAG=
# Free loopback port for the reverse proxy. Confirm with vps-discovery.sh before choosing.
API_HOST_PORT=18010
POSTGRES_PASSWORD=
REDIS_PASSWORD=

# --- Application secrets ----------------------------------------------------------------
ADMIN_JWT_SECRET=

# Where monitor.sh sends alerts: a Slack or Discord incoming webhook, or any endpoint that
# accepts a JSON POST. Treat it as a secret.
ALERT_WEBHOOK_URL=

# --- Public addressing ------------------------------------------------------------------
API_PUBLIC_HOST=api.terrific-bites.trunexus.ai
TRUSTED_HOSTS=api.terrific-bites.trunexus.ai
CORS_ALLOWED_ORIGINS=https://terrific-bites.trunexus.ai
ADMIN_COOKIE_DOMAIN=terrific-bites.trunexus.ai
MEDIA_BASE_URL=https://api.terrific-bites.trunexus.ai/media

LOG_LEVEL=INFO

# --- Odoo catalogue pull (read-only) ----------------------------------------------------
# Leave blank until the production Odoo instance is decided: the catalogue sync then
# reports "not configured" and the catalogue stays as seeded. Order push stays on the stub
# regardless; it is fixed in docker-compose.prod.yml.
ODOO_BASE_URL=
ODOO_DATABASE=
ODOO_USERNAME=
ODOO_PASSWORD=
ODOO_API_KEY=
