# Copy to backend/.env for local (non-Docker) development. Never commit the real .env.
# Docker Compose sets its own service-network values in docker-compose.yml and does not
# read this file directly.

APP_NAME=Terrific Bites API
APP_VERSION=0.1.0
APP_ENV=development
DEBUG=true

API_V1_PREFIX=/api/v1
HOST=0.0.0.0
PORT=8000

LOG_LEVEL=INFO

# Local (non-Docker) Postgres — adjust to your local instance.
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/terrific_bites
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10

# Local (non-Docker) Redis.
REDIS_URL=redis://localhost:6379/0

CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# Comma-separated. Must include the frontend's local dev origin.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080
TRUSTED_HOSTS=localhost,127.0.0.1

# Odoo (Phase 4) — read by app/integrations/odoo/config.py. Set ODOO_BASE_URL/
# DATABASE/USERNAME plus exactly one of ODOO_PASSWORD/ODOO_API_KEY to enable the
# client; leave all empty to keep Odoo unconfigured (verify_odoo_connection reports
# BLOCKED with an explicit reason, never fabricates a result). See
# docs/integrations/odoo-operations-runbook.md.
#
# ODOO_ORDER_PUSH_PROVIDER defaults to "stub" in app/core/config.py (Launch Sprint
# default — never contacts Odoo, but still marks orders odoo_sync_status=synced with
# odoo_sale_order_id=NULL, so the outbox looks fully drained with nothing actually
# pushed). Any environment where orders must really reach Odoo — including production —
# MUST set this to "live" explicitly; it is never inferred from ODOO_BASE_URL being set.
ODOO_ORDER_PUSH_PROVIDER=stub
ODOO_BASE_URL=
ODOO_DATABASE=
ODOO_USERNAME=
ODOO_PASSWORD=
ODOO_API_KEY=
ODOO_TIMEOUT_SECONDS=30
ODOO_VERIFY_SSL=true
ODOO_MAX_RETRIES=3
ODOO_RETRY_BACKOFF_SECONDS=1.0
ODOO_READ_BATCH_SIZE=200
ODOO_PROTOCOL=jsonrpc
ODOO_COMPANY_ID=
ODOO_DEFAULT_PRICELIST_ID=
ODOO_DEFAULT_WAREHOUSE_ID=
# Which stock.location counts as "available for the storefront" when summing
# stock.quant. Leave blank to sum every internal-usage location.
ODOO_STOCK_LOCATION_ID=

# Odoo -> PostgreSQL catalogue pull sync (app/services/catalogue/
# odoo_catalogue_sync_service.py) — the reverse of the import service above. Runs on
# a Celery beat schedule and via the Admin Portal's "Sync now" button.
ODOO_CATALOGUE_SYNC_MAX_RECORDS=5000
ODOO_CATALOGUE_SYNC_INTERVAL_SECONDS=300

# Local-disk storage for product images pulled from Odoo (image_1920 base64
# payloads). MEDIA_BASE_URL must be reachable by the browser rendering the
# storefront/admin portal — point it at wherever this API is actually served from.
MEDIA_ROOT=media
MEDIA_BASE_URL=http://localhost:8000/media

# Checkout pricing (Launch Sprint) — mirrors the Admin Portal's current
# localStorage-only defaults (src/lib/admin-store.ts SiteSettings). Checkout always
# recomputes from these server-side; a client can never submit its own tax/delivery/total.
CHECKOUT_TAX_RATE_PERCENT=5.0
CHECKOUT_DEFAULT_DELIVERY_FEE=15.0
CHECKOUT_FREE_DELIVERY_THRESHOLD=0.0
CHECKOUT_MIN_ORDER_AMOUNT=30.0

# Selective Redis caching (cache-aside) for GET /api/v1/catalogue/* — see
# docs/backend/redis-caching.md. Redis is an acceleration layer only; PostgreSQL stays
# authoritative and every catalogue endpoint keeps working with CACHE_ENABLED=false or
# Redis stopped outright.
CACHE_ENABLED=true
CACHE_KEY_PREFIX=tb
CACHE_HOMEPAGE_TTL_SECONDS=300
CACHE_CATEGORIES_TTL_SECONDS=900
CACHE_PRODUCT_DETAIL_TTL_SECONDS=300
CACHE_MOMENTS_TTL_SECONDS=900
CACHE_RECIPIENTS_TTL_SECONDS=900
CACHE_PRODUCT_LIST_TTL_SECONDS=120
CACHE_REDIS_OPERATION_TIMEOUT_SECONDS=1
CACHE_MAX_PRODUCT_LIST_KEYS=500
CACHE_LOG_HITS=false
CACHE_COMPRESSION_ENABLED=false
CACHE_DEBUG_HEADERS_ENABLED=true
